#!/bin/sh

if [ "$(id -u)" -ne 0 ]; then
    exec sudo -- /usr/local/bin/kage-paket-yenile
fi

if LC_ALL=C apt-get -o APT::Update::Error-Mode=any -o Acquire::Retries=1 \
    -o Acquire::https::Timeout=20 -o Acquire::http::Timeout=20 update; then
    install -d -m 755 /run/kage && touch /run/kage/apt-listeleri-yenilendi
    printf '\nDebian paket listeleri güncellendi. Paketleri Synaptic’ten veya APT ile kurabilirsin.\n'
else
    status=$?
    printf '\nPaket listeleri güncellenemedi. Yukarıdaki APT mesajı hatanın nedenini gösterir.\n' >&2
    exit "$status"
fi
