#!/bin/sh
set -eu
wallpaper=/usr/share/backgrounds/kage/kage.jpg
default=/usr/share/backgrounds/xfce/xfce-x.svg
{
    printf '%s' '<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="2560" height="1440" viewBox="0 0 2560 1440"><image width="2560" height="1440" xlink:href="data:image/jpeg;base64,'
    base64 -w 0 "$wallpaper"
    printf '%s\n' '"/></svg>'
} > "$default"
